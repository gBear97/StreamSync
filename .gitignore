# build outputs
build/
dist/
*.spec

# python
__pycache__/
*.pyc

# local state
.streamsync.json

# macos
.DS_Store

# local media - test films are big, and not ours to redistribute
*.mp4
*.mkv
*.mov
*.avi
*.m4a
*.wav

# signing keys and secrets: they live in the password manager and the
# repository's Actions secrets, never in a commit. The README keeps them
# outside the checkout; this is the backstop for when one lands here.
*.pem
*.p12
*.p8
*.key
*.pfx
.env
.env.*

# agent worktrees (also in .git/info/exclude, which clones don't inherit)
.claude/worktrees/
